    </tasks>
    <tasks name="MemSafety-Other">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/MemSafety-Other.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/valid-memsafety.prp</propertyfile>
    </tasks>
    <tasks name="MemSafety-Juliet">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/MemSafety-Juliet.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/valid-memsafety.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="SV-COMP_no-overflow">
    <tasks name="NoOverflows-Main">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/NoOverflows-Main.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/no-overflow.prp</propertyfile>
    </tasks>
    <tasks name="NoOverflows-Juliet">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/NoOverflows-Juliet.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/no-overflow.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="SV-COMP_termination">
    <tasks name="Termination-MainControlFlow">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/Termination-MainControlFlow.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/termination.prp</propertyfile>
    </tasks>
    <tasks name="Termination-MainHeap">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/Termination-MainHeap.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/termination.prp</propertyfile>
    </tasks>
    <tasks name="Termination-Other">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/Termination-Other.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/termination.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="SV-COMP_no-data-race">
    <tasks name="NoDataRace-Main">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/NoDataRace-Main.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/no-data-race.prp</propertyfile>
    </tasks>
  </rundefinition>

</benchmark>
