<?xml version="1.0"?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 2.3//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">

<!--
  SAF SV-COMP benchmark definition (plan 203) — a FULL, official-style BenchExec
  run at competition resource limits (900 s CPU / 15 GB / 4 cores).

  One rundefinition per property; the tasks blocks pull the official category .set
  files from the sv-benchmarks checkout. The vendored benchexec/tools/saf.py provides
  tool="saf": it invokes `saf verify` with the property, data-model, and witness
  flags, then maps stdout to a BenchExec result. `saf verify` prints `unknown` for
  properties SAF does not (yet) handle, which score 0, never a scoring-negative guess.

  Run it with scripts/run_benchexec_svcomp.sh (which installs the tool-info module
  and puts `saf` on PATH). To score only the HOLDOUT slice instead of the whole
  pool, use the split-specific def generated by scripts/svcomp_split.py
  (tests/benchmarks/svcomp-splits/holdout.bench.xml).

  IMPORTANT — the .set names below are the long-stable SV-COMP category files, but
  the exact list is edition-specific. Confirm against your checked-out tag with:
      ls tests/benchmarks/sv-benchmarks/c/*.set
  and add/remove rows to match c/category-structure.yml. A referenced-but-missing
  .set makes BenchExec error out — comment out any your tag lacks.

  Match the DTD version (2.3 here) to your installed BenchExec if it complains.
-->
<benchmark tool="saf" timelimit="900 s" memlimit="15 GB" cpuCores="4">

  <resultfiles>**/witness.yml</resultfiles>
  <option name="--witness">witness.yml</option>

  <rundefinition name="SV-COMP_unreach-call">
    <tasks name="ReachSafety-Arrays">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/ReachSafety-Arrays.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="ReachSafety-BitVectors">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/ReachSafety-BitVectors.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="ReachSafety-ControlFlow">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/ReachSafety-ControlFlow.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="ReachSafety-ECA">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/ReachSafety-ECA.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="ReachSafety-Floats">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/ReachSafety-Floats.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="ReachSafety-Heap">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/ReachSafety-Heap.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="ReachSafety-Loops">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/ReachSafety-Loops.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="ReachSafety-Recursive">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/ReachSafety-Recursive.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="ReachSafety-Sequentialized">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/ReachSafety-Sequentialized.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
    <tasks name="SoftwareSystems-DeviceDriversLinux64-ReachSafety">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/SoftwareSystems-DeviceDriversLinux64-ReachSafety.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/unreach-call.prp</propertyfile>
    </tasks>
  </rundefinition>

  <rundefinition name="SV-COMP_valid-memsafety">
    <tasks name="MemSafety-Arrays">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/MemSafety-Arrays.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/valid-memsafety.prp</propertyfile>
    </tasks>
    <tasks name="MemSafety-Heap">
      <includesfile>../tests/benchmarks/sv-benchmarks/c/MemSafety-Heap.set</includesfile>
      <propertyfile>../tests/benchmarks/sv-benchmarks/c/properties/valid-memsafety.prp</propertyfile>
    </tasks>
    <tasks name="MemSafety-LinkedLists">
