# scripts/loop/loop.env — run-config for supervisor.sh (sourced at startup).
# Conditional (${VAR:-default}) so this is the SERVICE default yet still overridable for ad-hoc dev
# runs, e.g.  EVAL_SAMPLE=8 MAX_TURNS=12 bash supervisor.sh --once <lever>.

# --- Claude worker ---
export CLAUDE_ENV_FILE="${CLAUDE_ENV_FILE:-/home/ubuntu/.claude-code.env}"   # proxy auth
export MAX_TURNS="${MAX_TURNS:-60}"                       # room for a real feature slice
export WORKER_WALL_TIMEOUT="${WORKER_WALL_TIMEOUT:-5400}" # per-attempt wall-clock watchdog (s)
export WORKER_MAX_ATTEMPTS="${WORKER_MAX_ATTEMPTS:-8}"
export ALLOWED_TOOLS="${ALLOWED_TOOLS:-Read,Grep,Glob,Edit,Write,Bash,WebSearch,WebFetch}"
export CLAUDE_CODE_MAX_RETRIES="${CLAUDE_CODE_MAX_RETRIES:-4}"   # low: supervisor owns the sleep policy
export API_TIMEOUT_MS="${API_TIMEOUT_MS:-1200000}"

# --- Eval (immutable scorer) ---
export EVAL_JOBS="${EVAL_JOBS:-8}"                        # conservative: unreach PTA tasks are mem-heavy, no swap
export EVAL_TIMEOUT="${EVAL_TIMEOUT:-60}"
export EVAL_MAX_RSS_MB="${EVAL_MAX_RSS_MB:-3072}"         # RSS watchdog
export HELDOUT_EVERY_K="${HELDOUT_EVERY_K:-3}"
# After every N KEPT arms, run a FULL all-property eval to track the true C.FalseOverall trajectory and
# roll back any cross-family regression a "local" arm leaked. 3 balances safety vs eval cost; lower for
# tighter safety (more frequent, costlier), higher for throughput. A crosscut arm reuses its own eval.
export OVERALL_CHECKPOINT_EVERY_KEEP="${OVERALL_CHECKPOINT_EVERY_KEEP:-3}"
# Per-arm eval scope. A FULL-reservoir family eval (EVAL_SAMPLE unset) is ~20k memsafety tasks =>
# hours/arm — too slow for iteration. Default to a LARGE STRATIFIED SAMPLE so arms complete in ~tens
# of minutes and common false-alarm classes are still caught. Kept arms are CANDIDATES on auto/loop-*;
# the hard "FP=0 on the FULL reservoir" redline is enforced at the HUMAN MERGE boundary (the loop never
# merges to svcomp) — run `EVAL_SAMPLE= supervisor.sh --baseline` or the full split eval before cherry-
# picking. Set EVAL_SAMPLE= (empty) here to make every per-arm keep full-reservoir at slower cadence.
export EVAL_SAMPLE="${EVAL_SAMPLE:-1000}"

# --- Loop control ---
export MAX_ARMS="${MAX_ARMS:-100}"                        # arms per service start; Restart=always refills
export LEVER_BUDGET="${LEVER_BUDGET:-6}"                  # park a lever after N consecutive REVERTs (progress resets)
export ACCUMULATE_BUDGET="${ACCUMULATE_BUDGET:-3}"       # (BUG-4) park after N plain ACCUMULATEs with 0 KEEPs
export MAX_LEVER_ARMS="${MAX_LEVER_ARMS:-12}"            # hard cap on total arms per lever (bounds accumulation)
export SCRATCH_PREFIX="${SCRATCH_PREFIX:-auto/loop}"      # integration branch (never pushed/merged)
export CAP_PREFIX="${CAP_PREFIX:-cap}"                    # capability lineage cap-<family>/<n>
